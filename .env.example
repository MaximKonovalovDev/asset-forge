# Copy to .env and fill in. .env is gitignored.

# --- flax-mcp connection ---
# asset-forge is an MCP client of flax-mcp. Point at the running server.
ASSET_FORGE_MCP_URL=http://127.0.0.1:8765
ASSET_FORGE_MCP_TIMEOUT_SECONDS=60

# --- LLM (for style consistency + brief expansion + LL3M-style code gen) ---
ASSET_FORGE_ANTHROPIC_KEY=
ASSET_FORGE_OPENAI_KEY=
# Optional: local model via Ollama for cheap iterative use
ASSET_FORGE_OLLAMA_URL=http://127.0.0.1:11434

# --- Asset-gen route preferences (delegated to flax-asset-gen) ---
# Comma-separated, priority order. See docs/HARDWARE_REALITY.md for
# the 6GB-VRAM-verified route selection.
#
# SF3D removed: CC-BY-NC license, not usable for sellable packs.
# AniGen removed: requires 12+ GB VRAM, won't fit on 6 GB.
# TripoSR is lightest; TRELLIS-HF runs on HuggingFace's GPU not yours.
ASSET_FORGE_GEN_ROUTES=triposr,trellis-hf,hunyuan-mini,rodin-trial

# --- Blender ---
ASSET_FORGE_BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.4\blender.exe
ASSET_FORGE_BLENDER_HEADLESS=true

# --- Retopology backend ---
# quadremesher | instant-meshes | quadriflow | voxel-remesh
ASSET_FORGE_RETOPO_BACKEND=instant-meshes
ASSET_FORGE_INSTANT_MESHES_PATH=

# --- Marketplace credentials (used by manifest/submit module) ---
# These are NOT auto-submitted. Manifest generator produces the bundles;
# operator uploads manually for first 6 months until trust is built.
ASSET_FORGE_FAB_PUBLISHER_ID=
ASSET_FORGE_UNITY_PUBLISHER_ID=
ASSET_FORGE_ITCHIO_USER=
ASSET_FORGE_GUMROAD_KEY=

# --- Output paths ---
ASSET_FORGE_OUTPUT_ROOT=./out
ASSET_FORGE_CACHE_ROOT=./cache

# --- Render farm (for preview/showroom renders) ---
# local | cloud-blender | sheepit
ASSET_FORGE_RENDER_BACKEND=local
ASSET_FORGE_RENDER_THREADS=8
