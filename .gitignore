# Python
__pycache__/
*.pyc
*.pyo
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/
*.egg-info/

# Asset outputs (huge binary; never commit raw produced assets)
out/
output/
generated/
renders/
*.blend
*.blend1
*.fbx
*.glb
*.gltf
*.usdz
*.obj
*.usd
*.usdc
*.usda
