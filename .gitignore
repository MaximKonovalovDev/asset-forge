*.jpg.import
# DO commit briefs and small reference images per pack:
!packs/**/brief.yaml
!packs/**/reference/*.png
!packs/**/reference/*.jpg
!packs/**/README.md

# Secrets
.env
.env.*
!.env.example
*.key
*.pem

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Large local data
data/
cache/
.cache/
*.sqlite
*.db
